# Mobile Environment Variables
# Copy to .env and update the API_BASE_URL for your machine's local IP

# Replace with your Mac's local IP address (find with: ifconfig | grep inet)
# Use the IP that your phone can reach on the same WiFi network
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Example for physical device on same network:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000
